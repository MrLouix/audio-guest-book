[Unit]
Description=Livre d'or telephonique - bascule WiFi/AP (Sprint 8, spec §5.3)
After=NetworkManager.service
Wants=NetworkManager.service
# Garde-fou anti-boucle-de-crash (spec §7.1) : au-dela de ce seuil, le
# watchdog applicatif (livre-dor-watchdog.timer) fait reset-failed+restart.
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=/home/pi/livre_dor/scripts/wifi_or_ap.sh
RuntimeDirectory=livre_dor
TimeoutStartSec=60
