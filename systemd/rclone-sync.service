[Unit]
Description=Livre d'or telephonique - synchronisation Google Drive (spec §5.4)
# Deux jambes par cycle : messages/ en montant seul (rclone copy) puis
# audio_src/ en bidirectionnel (rclone bisync).
After=network-online.target
Wants=network-online.target
# Garde-fou anti-boucle-de-crash (spec §7.1) : au-dela de ce seuil, le
# watchdog applicatif (livre-dor-watchdog.timer) fait reset-failed+restart.
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=oneshot
WorkingDirectory=/home/pi/livre_dor
ExecStart=/home/pi/livre_dor/.venv/bin/python3 /home/pi/livre_dor/src/rclone_sync.py --run
# Marge pour le bisync initial (--resync), plus long que les cycles suivants.
TimeoutStartSec=600
# Indispensable : sans User=, le service tourne en root et ne trouve pas le
# remote (créé par `rclone config` dans ~/.config/rclone/ de l'utilisateur).
# Remplacé par l'utilisateur réel via le drop-in de scripts/lib_systemd.sh.
User=pi
